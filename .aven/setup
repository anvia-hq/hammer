#!/usr/bin/env bash
set -euo pipefail

# Environment for the Hammer repository. Versions pinned by the repository:
# Bun from .bun-version (1.4.4), Node from .node-version (major 24).
# CI (.github/workflows/ci.yml) installs the same pair, then runs
# `bun install --frozen-lockfile`. No databases or system libraries:
# the action is a bundled JS file with pure-JS dependencies.

echo "Installing system prerequisites..."
sudo apt-get update
sudo apt-get install -y --no-install-recommends ca-certificates curl unzip

BUN_WANT="$(cat .bun-version)"
export PATH="$HOME/.bun/bin:$PATH"
if command -v bun > /dev/null && [ "$(bun -v)" = "$BUN_WANT" ]; then
  echo "Bun $BUN_WANT already installed."
else
  echo "Installing Bun $BUN_WANT..."
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v$BUN_WANT"
fi

NODE_MAJOR_WANT="$(cut -d. -f1 < .node-version)"
if command -v node > /dev/null && [ "$(node -v | cut -d. -f1 | tr -d v)" = "$NODE_MAJOR_WANT" ]; then
  echo "Node $(node -v) already installed."
else
  echo "Installing Node $NODE_MAJOR_WANT.x..."
  curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR_WANT}.x" | sudo -E bash -
  sudo apt-get install -y --no-install-recommends nodejs
fi

echo "Installing dependencies from the lockfile..."
bun install --frozen-lockfile

echo "Toolchain: bun $(bun -v), node $(node -v)"
