{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "**/dist",
    "coverage",
    "**/coverage",
    "bun.lock",
    "skills/*/SKILL.md"
  ]
}
