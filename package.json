{
  "name": "hammer-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint",
    "check:fix": "pnpm lint:fix && pnpm format",
    "eval": "pnpm --filter @anvia/hammer-eval eval",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "oxfmt": "0.64.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@valibot/to-json-schema": "^1.8.0"
  }
}
