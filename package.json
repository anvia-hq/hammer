{
  "name": "hammer-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run format:check && bun run lint",
    "check:fix": "bun run lint:fix && bun run format",
    "eval": "bun run --filter @anvia/hammer-eval eval",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "oxfmt": "0.64.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@valibot/to-json-schema": "^1.8.0"
  },
  "workspaces": [
    "packages/*",
    "eval"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
